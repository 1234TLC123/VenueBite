# Public browser token only. Never use a server-only sk. token here.
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
# Optional ISO country filter; empty leaves supported geography unrestricted.
MAPBOX_SEARCH_COUNTRIES=
# Set to your app origin when using a URL-restricted public token.
MAPBOX_REQUEST_ORIGIN=http://127.0.0.1:5000
# Per-request timeout in seconds; valid range > 0 to 30, default 6.
MAPBOX_HTTP_TIMEOUT_SECONDS=6
# Default nearby radius in miles: 1, 3, or 5. The form can override it.
COMPETITION_RADIUS_MILES=3
CENSUS_API_KEY=your_census_api_key_here
CENSUS_HTTP_TIMEOUT_SECONDS=8
# Private server-only token; never sent to the browser.
REGRID_API_TOKEN=your_regrid_api_token_here
REGRID_HTTP_TIMEOUT_SECONDS=8
# One nearby fallback after an empty exact lookup; 0 disables it, maximum 30 meters.
REGRID_FALLBACK_RADIUS_METERS=25
# Optional stable random signing key. Otherwise generated at each app start.
SECRET_KEY=
# Optional SQLite path. Default: instance/venuebite.db (Git ignored).
VENUEBITE_DATABASE_PATH=
# Public official Denver GIS lookup; no API key required. Disable for offline use.
REGULATORY_ENABLED=true
REGULATORY_HTTP_TIMEOUT_SECONDS=6
# Optional, private server-only AI key. Leave blank for graceful AI-unavailable mode.
OPENAI_API_KEY=
# Cost-conscious Responses API model; configurable without changing application code.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=25
OPENAI_MAX_OUTPUT_TOKENS=1400
FLASK_APP=app
FLASK_DEBUG=0
