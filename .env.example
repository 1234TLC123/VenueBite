# Public browser token only. Never use a server-only sk. token here.
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
# Optional ISO country filter; empty leaves supported geography unrestricted.
MAPBOX_SEARCH_COUNTRIES=
# Set to your app origin when using a URL-restricted public token.
MAPBOX_REQUEST_ORIGIN=http://127.0.0.1:5000
# Per-request timeout in seconds; valid range > 0 to 30, default 6.
MAPBOX_HTTP_TIMEOUT_SECONDS=6
# Default nearby radius in miles: 1, 3, or 5. The form can override it.
COMPETITION_RADIUS_MILES=3
CENSUS_API_KEY=your_census_api_key_here
CENSUS_HTTP_TIMEOUT_SECONDS=8
# Optional stable random signing key. Otherwise generated at each app start.
SECRET_KEY=
FLASK_APP=app
FLASK_DEBUG=0
